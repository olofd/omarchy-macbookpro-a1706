+    /// The level slider's area: the whole bar right of Esc.
+    #[must_use]
+    pub(crate) fn slider_bounds(self) -> Rectangle {
+        let left = self.escape_right().saturating_add(self.scaled_x(10));
+        Rectangle {
+            x: left,
+            y: self.scaled_y(PLATE_Y),
+            width: self.width.saturating_sub(left),
