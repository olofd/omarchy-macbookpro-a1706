+#define T1_SEQPACKET_READY_CLIENT 1
+#define T1_SEQPACKET_READY_WAKE 2
+
+/*
+ * Block until the connected client has a packet or a hangup to report, the
+ * optional wake descriptor (-1 for none) is readable, or timeout_ms passes
+ * (-1 waits indefinitely). *ready receives T1_SEQPACKET_READY_CLIENT and/or
+ * T1_SEQPACKET_READY_WAKE; zero means the timeout passed. Nothing is
+ * consumed: the caller receives the packet and drains the wake descriptor.
+ */
+enum t1_seqpacket_status t1_seqpacket_wait_readable(int client_descriptor,
+	int wake_descriptor, int timeout_ms, int *ready);
