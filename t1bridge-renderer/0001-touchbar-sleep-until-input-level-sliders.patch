+    /// Reads the current level as a percentage of the maximum, for a renderer
+    /// that shows it (the volume-style slider). Writes stay with the service.
+    ///
+    /// # Errors
+    ///
+    /// Returns a static category when the class or current value is invalid.
+    pub fn current_percentage(&self, kind: BrightnessKind) -> Result<u8, BrightnessError> {
+        let device = self.device(kind)?;
+        let current = read_attribute(&device.brightness_path)?;
+        if current > device.maximum || device.maximum == 0 {
+            return Err(BrightnessError::InvalidAttribute);
+        }
+        let percentage =
+            (u64::from(current) * 100 + u64::from(device.maximum) / 2) / u64::from(device.maximum);
+        u8::try_from(percentage).map_err(|_| BrightnessError::InvalidAttribute)
+    }
