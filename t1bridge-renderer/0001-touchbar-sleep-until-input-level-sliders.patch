 	close_descriptor(descriptors[1]);
 }
 
+static void test_wait_readable_reports_packets_wakes_hangups_and_timeouts(void)
+{
+	static const uint8_t packet[] = { 0x54, 0x31, 0x57, 0x52 };
+	int descriptors[2] = { -1, -1 };
+	int wake[2] = { -1, -1 };
+	int ready = 99;
+	uint8_t buffer[sizeof(packet)] = { 0 };
+	size_t length = 0;
+
+	create_pair(descriptors);
+	EXPECT_TRUE(socketpair(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0, wake) == 0);
+	EXPECT_STATUS(T1_SEQPACKET_OK,
+		      t1_seqpacket_wait_readable(descriptors[0], wake[0], 0, &ready));
+	EXPECT_TRUE(ready == 0);
+	EXPECT_TRUE(write(wake[1], "w", 1) == 1);
+	EXPECT_STATUS(T1_SEQPACKET_OK,
+		      t1_seqpacket_wait_readable(descriptors[0], wake[0], -1, &ready));
+	EXPECT_TRUE(ready == T1_SEQPACKET_READY_WAKE);
+	EXPECT_TRUE(send(descriptors[1], packet, sizeof(packet), MSG_NOSIGNAL) ==
+		    (ssize_t)sizeof(packet));
+	EXPECT_STATUS(T1_SEQPACKET_OK,
+		      t1_seqpacket_wait_readable(descriptors[0], -1, -1, &ready));
+	EXPECT_TRUE(ready == T1_SEQPACKET_READY_CLIENT);
+	EXPECT_STATUS(T1_SEQPACKET_OK,
+		      t1_seqpacket_wait_readable(descriptors[0], wake[0], 0, &ready));
+	EXPECT_TRUE(ready == (T1_SEQPACKET_READY_CLIENT | T1_SEQPACKET_READY_WAKE));
+	EXPECT_STATUS(T1_SEQPACKET_OK,
+		      t1_seqpacket_receive(descriptors[0], buffer, sizeof(buffer),
+				       &length));
+	EXPECT_TRUE(length == sizeof(packet));
+	close_descriptor(descriptors[1]);
+	EXPECT_STATUS(T1_SEQPACKET_OK,
+		      t1_seqpacket_wait_readable(descriptors[0], -1, 0, &ready));
+	EXPECT_TRUE(ready == T1_SEQPACKET_READY_CLIENT);
+	EXPECT_STATUS(T1_SEQPACKET_INVALID_ARGUMENT,
+		      t1_seqpacket_wait_readable(descriptors[0], -1, -2, &ready));
+	EXPECT_STATUS(T1_SEQPACKET_INVALID_ARGUMENT,
+		      t1_seqpacket_wait_readable(descriptors[0], -1, 0, NULL));
+	close_descriptor(descriptors[0]);
+	close_descriptor(wake[0]);
+	close_descriptor(wake[1]);
+}
