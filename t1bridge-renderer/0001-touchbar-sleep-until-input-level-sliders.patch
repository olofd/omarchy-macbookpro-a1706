index 0000000..88f818a
--- /dev/null
+++ b/crates/t1-touchbar/src/wake.rs
@@ -0,0 +1,72 @@
+//! Wakes the built-in renderer's input wait from another thread.
+//!
+//! The renderer sleeps in `poll(2)` on the hardware socket until input, its
+//! next timer, or news from a background thread (desktop state, the Touch ID
+//! overlay). The threads cannot touch that socket, so they write one byte to a
+//! local socket pair that the renderer waits on as well.
+
+use std::io::{self, Read, Write};
+use std::os::fd::{AsFd, BorrowedFd};
+use std::os::unix::net::UnixStream;
+use std::sync::Arc;
+
+/// Sending half: cheap to clone and never blocks. A full buffer only means a
+/// wake is already pending, so the write result is ignored.
+#[derive(Clone, Debug)]
+pub struct Waker(Arc<UnixStream>);
+
+impl Waker {
+    /// Makes the renderer's current or next wait return at once.
+    pub fn wake(&self) {
+        let _ = (&*self.0).write(&[1]);
+    }
+}
+
+/// Receiving half, waited on next to the hardware socket.
+#[derive(Debug)]
+pub struct WakeReceiver(UnixStream);
+
+impl WakeReceiver {
+    /// Consumes every pending wake, so the next wait sleeps again.
+    pub fn drain(&self) {
+        let mut buffer = [0_u8; 64];
+        while matches!((&self.0).read(&mut buffer), Ok(length) if length > 0) {}
+    }
+}
+
+impl AsFd for WakeReceiver {
+    fn as_fd(&self) -> BorrowedFd<'_> {
+        self.0.as_fd()
+    }
+}
+
+/// Creates a connected, nonblocking waker and receiver.
+///
+/// # Errors
+///
+/// Returns the I/O error if the socket pair cannot be created or configured.
+pub fn pair() -> io::Result<(Waker, WakeReceiver)> {
+    let (sender, receiver) = UnixStream::pair()?;
+    sender.set_nonblocking(true)?;
+    receiver.set_nonblocking(true)?;
+    Ok((Waker(Arc::new(sender)), WakeReceiver(receiver)))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn wake_is_readable_until_drained() {
+        let (waker, receiver) = pair().expect("socket pair");
+        waker.wake();
+        waker.wake();
+        let mut buffer = [0_u8; 8];
+        assert!(matches!((&receiver.0).read(&mut buffer), Ok(length) if length > 0));
+        receiver.drain();
+        assert!(
+            (&receiver.0).read(&mut buffer).is_err(),
+            "drained receiver would block"
+        );
+    }
+}
