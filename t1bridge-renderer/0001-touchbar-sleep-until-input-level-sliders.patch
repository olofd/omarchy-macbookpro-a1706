+
+    /// The slider's track, right of its icon: a drag across its whole width
+    /// spans 0 to 100 %.
+    #[must_use]
+    pub(crate) fn slider_track(self) -> Rectangle {
+        let bounds = self.slider_bounds();
+        let icon = bounds.height.saturating_mul(2);
+        let pad = self.scaled_x(36);
+        let left = bounds.x.saturating_add(icon);
+        let right = bounds.x.saturating_add(bounds.width).saturating_sub(pad);
+        let height = (bounds.height / 6).max(2);
+        Rectangle {
+            x: left,
+            y: bounds.y + (bounds.height - height) / 2,
+            width: right.saturating_sub(left),
+            height,
+        }
+    }
+
+    /// Draws Esc and the slider for `target` at `level` percent (`muted` only
+    /// changes the volume icon).
+    ///
+    /// # Errors
+    ///
+    /// Rejects a changed frame geometry or an internally invalid draw.
+    pub(crate) fn render_slider(
+        self,
+        frame: &mut Xrgb8888Frame<'_>,
+        target: SliderTarget,
+        level: u8,
+        muted: bool,
+    ) -> Result<(), StockSliceError> {
+        if frame.width() != self.width || frame.height() != self.height {
+            return Err(StockSliceError::FrameGeometryMismatch);
+        }
+        frame.clear(BACKGROUND);
+        self.draw_plate(frame, self.escape_bounds(), StockAction::Escape, None)?;
+        stock_art::draw_label(frame, self.escape_bounds(), stock_labels::ESC, LABEL)?;
+        let bounds = self.slider_bounds();
+        if bounds.width == 0 {
+            return Ok(());
+        }
+        stock_art::draw_rounded_plate(frame, bounds, self.scaled_y(PLATE_RADIUS).max(1), PLATE)?;
+        let icon = Rectangle {
+            width: bounds.height.saturating_mul(2).min(bounds.width),
+            ..bounds
+        };
+        let symbol = match target {
+            SliderTarget::Volume if muted => Symbol::Mute,
+            SliderTarget::Volume => Symbol::VolumeUp,
+            SliderTarget::DisplayBrightness => Symbol::DisplayUp,
+            SliderTarget::KeyboardBacklight => Symbol::KeyboardUp,
+        };
+        stock_art::draw_symbol(frame, icon, symbol, LABEL)?;
+        let track = self.slider_track();
+        if track.width == 0 {
+            return Ok(());
+        }
+        let radius = track.height / 2;
+        stock_art::draw_rounded_plate(frame, track, radius, PRESSED_PLATE)?;
+        let filled = u32::try_from(u64::from(track.width) * u64::from(level.min(100)) / 100)
+            .unwrap_or(track.width);
+        if filled > 0 {
+            let fill = Rectangle {
+                width: filled,
+                ..track
+            };
+            stock_art::draw_rounded_plate(frame, fill, radius, LABEL)?;
+        }
+        // The knob: a disc on the fill's end, kept inside the slider plate.
+        let knob = (bounds.height * 3 / 5).max(2);
+        let centre = track.x + filled;
+        let left = centre
+            .saturating_sub(knob / 2)
+            .clamp(bounds.x, bounds.x + bounds.width - knob.min(bounds.width));
+        let knob_bounds = Rectangle {
+            x: left,
+            y: bounds.y + (bounds.height - knob) / 2,
+            width: knob,
+            height: knob,
+        };
+        stock_art::draw_rounded_plate(frame, knob_bounds, knob / 2, LABEL)?;
+        Ok(())
+    }
