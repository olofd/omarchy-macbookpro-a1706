 use std::os::fd::{AsFd, AsRawFd, BorrowedFd, OwnedFd};
 use std::sync::atomic::{AtomicBool, Ordering};
+use std::time::Duration;
 
 use crate::ffi;
 
+const READY_CLIENT: std::ffi::c_int = 1;
+const READY_WAKE: std::ffi::c_int = 2;
+
+/// What [`SeqPacketClient::wait_readable`] found ready; both false means the
+/// timeout passed.
+#[derive(Clone, Copy, Debug, Default, Eq, PartialEq)]
+pub struct Readiness {
+    /// The client has a packet, or a hangup, to receive.
+    pub client: bool,
+    /// The wake descriptor is readable.
+    pub wake: bool,
+}
+
 /// Kernel-supplied identity for one connected local peer.
 #[derive(Clone, Copy, Debug, Eq, PartialEq)]
 #[allow(clippy::struct_field_names)]
@@ -365,6 +379,33 @@ impl<'fd> SeqPacketClient<'fd> {
         Ok(peer_closed)
     }
 
+    /// Blocks until this client has a packet (or a hangup) to receive, `wake`
+    /// is readable, or `timeout` passes; `None` waits indefinitely. Nothing is
+    /// consumed: receive the packet, and drain `wake`, afterwards. The timeout
+    /// is rounded up to whole milliseconds, so a deadline is never woken early.
+    ///
+    /// # Errors
+    ///
+    /// Returns a static error for an invalid socket, interruption, or a failed
+    /// wait.
+    pub fn wait_readable(
+        self,
+        wake: Option<BorrowedFd<'_>>,
+        timeout: Option<Duration>,
+    ) -> Result<Readiness, SeqPacketError> {
+        let timeout_ms = timeout.map_or(-1, |timeout| {
+            let millis = timeout.as_nanos().div_ceil(1_000_000);
+            std::ffi::c_int::try_from(millis).unwrap_or(std::ffi::c_int::MAX)
+        });
+        let wake = wake.map_or(-1, |wake| wake.as_raw_fd());
+        let (status, ready) = ffi::wait_readable(self.descriptor.as_raw_fd(), wake, timeout_ms);
+        check(status)?;
+        Ok(Readiness {
+            client: ready & READY_CLIENT != 0,
+            wake: ready & READY_WAKE != 0,
+        })
+    }
+
