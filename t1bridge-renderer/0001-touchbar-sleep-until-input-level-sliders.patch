+//! The level sliders: slide a finger on the volume controls (mute, down, up),
+//! the display brightness controls or the keyboard backlight controls, and the
+//! bar becomes one wide slider for that level that follows the finger, until
+//! shortly after it lifts.
+//!
+//! The level moves with the finger relative to where the drag began, so it
+//! never jumps to the finger's position on the bar.
+
+use std::time::Duration;
+
+/// How long the slider stays after the finger lifts before the bar returns.
+pub const LINGER: Duration = Duration::from_millis(1_500);
+
+/// The level a slider sets.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum SliderTarget {
+    Volume,
+    DisplayBrightness,
+    KeyboardBacklight,
+}
+
+/// One drag on the bar, as the input interpreter reports it.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum DragInput {
+    /// A contact crossed the drag threshold; `target` is the level whose
+    /// controls it started on, if any.
+    Start {
+        x: f64,
+        target: Option<SliderTarget>,
+    },
+    /// The dragging contact moved to `x`.
+    Move { x: f64 },
+    /// The dragging contact lifted.
+    End,
+}
+
+/// Slider state while it is on the bar.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct LevelSlider {
+    target: SliderTarget,
+    from_level: u8,
+    from_x: f64,
+    level: u8,
+    dragging: bool,
+    hide_at: Option<Duration>,
+}
+
+impl LevelSlider {
+    /// A slider for `target` grabbed at `x` while it is at `level` percent.
+    #[must_use]
+    pub fn start(target: SliderTarget, level: u8, x: f64) -> Self {
+        let level = level.min(100);
+        Self {
+            target,
+            from_level: level,
+            from_x: x,
+            level,
+            dragging: true,
+            hide_at: None,
+        }
+    }
+
+    #[must_use]
+    pub const fn target(&self) -> SliderTarget {
+        self.target
+    }
+
+    /// The level shown, in percent.
+    #[must_use]
+    pub const fn level(&self) -> u8 {
+        self.level
+    }
+
+    #[must_use]
+    pub const fn dragging(&self) -> bool {
+        self.dragging
+    }
+
+    /// Grabs the shown slider again at `x`, continuing from its level.
+    pub fn regrab(&mut self, x: f64) {
+        self.from_level = self.level;
+        self.from_x = x;
+        self.dragging = true;
+        self.hide_at = None;
+    }
+
+    /// Follows the finger to `x` on a track `track_width` pixels wide (the
+    /// whole track is 0 to 100 %). Returns the new level when it changed.
+    pub fn drag_to(&mut self, x: f64, track_width: u32) -> Option<u8> {
+        if !self.dragging || track_width == 0 {
+            return None;
+        }
+        let delta = (x - self.from_x) * 100.0 / f64::from(track_width);
+        let level = (f64::from(self.from_level) + delta)
+            .round()
+            .clamp(0.0, 100.0);
+        // Clamped to 0..=100 above, so the conversion cannot truncate.
+        #[allow(clippy::cast_possible_truncation, clippy::cast_sign_loss)]
+        let level = level as u8;
+        if level == self.level {
+            return None;
+        }
+        self.level = level;
+        Some(level)
+    }
+
+    /// The finger lifted at `now`: the slider stays for [`LINGER`].
+    pub fn release(&mut self, now: Duration) {
+        self.dragging = false;
+        self.hide_at = Some(now.saturating_add(LINGER));
+    }
+
+    /// Whether the slider should give the bar back at `now`.
+    #[must_use]
+    pub fn expired(&self, now: Duration) -> bool {
+        self.hide_at.is_some_and(|hide_at| now >= hide_at)
+    }
+
+    /// Time until the slider hides, once released.
+    #[must_use]
+    pub fn hides_in(&self, now: Duration) -> Option<Duration> {
+        self.hide_at.map(|hide_at| hide_at.saturating_sub(now))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn follows_the_finger_relative_to_the_grab() {
+        let mut slider = LevelSlider::start(SliderTarget::Volume, 40, 1_000.0);
+        assert_eq!(slider.drag_to(1_000.0, 1_000), None);
+        assert_eq!(slider.drag_to(1_100.0, 1_000), Some(50));
+        assert_eq!(slider.drag_to(700.0, 1_000), Some(10));
+        assert_eq!(slider.level(), 10);
+    }
+
+    #[test]
+    fn clamps_to_the_volume_range() {
+        let mut slider = LevelSlider::start(SliderTarget::Volume, 90, 0.0);
+        assert_eq!(slider.drag_to(5_000.0, 1_000), Some(100));
+        assert_eq!(slider.drag_to(-5_000.0, 1_000), Some(0));
+    }
+
+    #[test]
+    fn lingers_after_release_and_regrabs_from_its_level() {
+        let mut slider = LevelSlider::start(SliderTarget::DisplayBrightness, 20, 0.0);
+        slider.drag_to(300.0, 1_000);
+        slider.release(Duration::from_secs(1));
+        assert_eq!(slider.drag_to(900.0, 1_000), None, "no drag while released");
+        assert!(!slider.expired(Duration::from_secs(1)));
+        assert_eq!(
+            slider.hides_in(Duration::from_secs(2)),
+            Some(Duration::from_millis(500))
+        );
+        assert!(slider.expired(Duration::from_millis(2_500)));
+        slider.regrab(100.0);
+        assert!(slider.dragging());
+        assert_eq!(slider.drag_to(200.0, 1_000), Some(60));
+    }
+}
