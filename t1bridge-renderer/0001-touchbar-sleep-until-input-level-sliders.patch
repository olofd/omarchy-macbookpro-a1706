diff --git a/crates/t1-daemons/c/t1_seqpacket.c b/crates/t1-daemons/c/t1_seqpacket.c
index 7957bda..f83ed91 100644
--- a/crates/t1-daemons/c/t1_seqpacket.c
+++ b/crates/t1-daemons/c/t1_seqpacket.c
@@ -495,6 +495,43 @@ enum t1_seqpacket_status t1_seqpacket_peer_closed(int client_descriptor,
 	return T1_SEQPACKET_OK;
 }
 
+enum t1_seqpacket_status t1_seqpacket_wait_readable(int client_descriptor,
+	int wake_descriptor, int timeout_ms, int *ready)
+{
+	enum t1_seqpacket_status status;
+	struct pollfd descriptors[2];
+	nfds_t count = 1;
+	int result;
+
+	if (ready == NULL || timeout_ms < -1)
+		return T1_SEQPACKET_INVALID_ARGUMENT;
+	*ready = 0;
+	status = validate_client(client_descriptor);
+	if (status != T1_SEQPACKET_OK)
+		return status;
+	memset(descriptors, 0, sizeof(descriptors));
+	descriptors[0].fd = client_descriptor;
+	descriptors[0].events = POLLIN;
+	if (wake_descriptor >= 0) {
+		descriptors[1].fd = wake_descriptor;
+		descriptors[1].events = POLLIN;
+		count = 2;
+	}
+	result = poll(descriptors, count, timeout_ms);
+	if (result < 0)
+		return transient_status(errno, T1_SEQPACKET_READINESS_FAILED);
+	if ((descriptors[0].revents & POLLNVAL) != 0 ||
+	    (count == 2 && (descriptors[1].revents & POLLNVAL) != 0))
+		return T1_SEQPACKET_READINESS_FAILED;
+	/* A hangup or error is reported as ready: the next receive returns it. */
+	if ((descriptors[0].revents & (POLLIN | POLLHUP | POLLERR)) != 0)
+		*ready |= T1_SEQPACKET_READY_CLIENT;
+	if (count == 2 &&
+	    (descriptors[1].revents & (POLLIN | POLLHUP | POLLERR)) != 0)
+		*ready |= T1_SEQPACKET_READY_WAKE;
+	return T1_SEQPACKET_OK;
+}
+
 static void close_descriptors(int *descriptors, size_t descriptor_count)
 {
 	size_t index;
