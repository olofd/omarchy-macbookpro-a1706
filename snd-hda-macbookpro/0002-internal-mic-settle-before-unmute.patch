+// The internal mic's path takes about half a second to settle after it powers up at a capture start: the
+// samples jump to full scale and drain back (a DC step through a high-pass filter), a thump that clipped the
+// first 0.1 s of every recording. The step happens before the input amp, so keeping the amp muted until it
+// has settled removes it (MacBookPro13,2: muted until 0.54 s, no step at the unmute).
+static unsigned int intmike_settle_ms = 500;
+module_param(intmike_settle_ms, uint, 0644);
+MODULE_PARM_DESC(intmike_settle_ms, "Apple: keep the internal mic muted for this long after a capture start (ms, 0 = off)");
+
+static struct hda_codec *cs_8409_settle_codec;
+
+static void cs_8409_intmike_settled(struct work_struct *work)
+{
+        if (cs_8409_settle_codec)
+                cs_8409_intmike_volume_unmute(cs_8409_settle_codec);
+}
+
+static DECLARE_DELAYED_WORK(cs_8409_intmike_settle_work, cs_8409_intmike_settled);
+
+static void cs_8409_intmike_settle_cancel(void)
+{
+        cancel_delayed_work_sync(&cs_8409_intmike_settle_work);
+}
+
 static void cs_8409_linein_volume_unmute(struct hda_codec *codec)
 {
         struct cs8409_apple_spec *spec = codec->spec;
@@ -3302,7 +3325,11 @@
         cs_8409_intmike_volume_setup(codec, 0x27);
         cs_8409_intmike_stream_on_nid(codec);
 
-        cs_8409_intmike_volume_unmute(codec);
+        if (intmike_settle_ms) {
+                cs_8409_settle_codec = codec;
+                schedule_delayed_work(&cs_8409_intmike_settle_work, msecs_to_jiffies(intmike_settle_ms));
+        } else
+                cs_8409_intmike_volume_unmute(codec);
         cs_8409_linein_volume_unmute(codec);
 
         // so here we get AMP_GAIN_MUTE setups but nothing changes
@@ -3366,6 +3393,8 @@
         //int retval;
         struct cs8409_apple_spec *spec = codec->spec;
 
+        cs_8409_intmike_settle_cancel();
+
 
